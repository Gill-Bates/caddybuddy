services:
  caddybuddy:
    image: docker.cirrio.de/caddybuddy:${CADDYBUDDY_VERSION:-1.0.0}
    container_name: caddybuddy
    restart: unless-stopped
    stop_grace_period: 20s
    environment:
      CB_SECRET_KEY: ${CB_SECRET_KEY:?Set CB_SECRET_KEY to a strong random value before starting caddybuddy.} # Generate with: head -c 32 /dev/urandom | base64
      CB_ADMIN_PASSWORD: ${CB_ADMIN_PASSWORD:?Set CB_ADMIN_PASSWORD to a non-default admin password before starting caddybuddy.}
      CB_SSLLABS_EMAIL: ${CB_SSLLABS_EMAIL:-}  # Required for SSL Labs scheduled scans
      LOG_LEVEL: ${LOG_LEVEL:-INFO}
      TZ: ${TZ:-Etc/UTC}
      HOST: 0.0.0.0
      PORT: ${PORT:-8000}
      TIMEOUT: ${TIMEOUT:-60}

    extra_hosts:
      - "host.docker.internal:host-gateway"

    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "5"
    security_opt:
      - no-new-privileges:true
    ports:
      - "127.0.0.1:${PORT:-8000}:8000"
    volumes:
      # Create the host Caddyfile before first start. CaddyBuddy imports it
      # into SQLite and then replaces the mounted file with a managed marker.
      - type: bind
        source: ${HOST_CADDYFILE_PATH:-/etc/caddy/Caddyfile}
        target: /app/Caddyfile
        bind:
          create_host_path: false
      - type: bind
        source: ./data
        target: /app/data

    healthcheck:
      test: ["CMD", "python", "-c", "import os, sys, urllib.request; port = os.environ.get('PORT', '8000'); response = urllib.request.urlopen(f'http://127.0.0.1:{port}/api/v1/health', timeout=3); sys.exit(0 if response.status < 500 else 1)"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s